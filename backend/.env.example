# SQLite works locally without a separate database server.
DATABASE_URL=sqlite:///./nexus.db
# PostgreSQL alternative: postgresql+psycopg://USER:PASSWORD@HOST:5432/nexus
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# Optional: only required for AI chat. Keep this key on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Internal URL reachable by the backend when AI fetches NEXUS data.
INTERNAL_API_URL=http://127.0.0.1:8000
